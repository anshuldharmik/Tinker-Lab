<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aesthetic Web Development Guide</title>
    <style>
        /* Base Styling & Theme */
        html {
            scroll-behavior: smooth;
        }
        body { 
            background-color: #0f172a; 
            color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Header Components */
        header {
            text-align: center;
            margin: 40px 0 20px 0;
        }
        h1 {
            font-size: 2.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            background: linear-gradient(to right, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 5px;
        }
        .subtitle {
            color: #94a3b8;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 4px;
        }

        /* Navigation Grid */
        .container { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 15px;
            width: 90%;
            max-width: 800px;
            margin: 20px auto 60px auto;
        }
        .nav-card {
            padding: 18px;
            text-align: center;
            border-radius: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .nav-card a {
            text-decoration: none;
            color: #ffffff;
            display: block;
        }
        
        /* Vibrant Aesthetic Accents */
        .card-html     { background: rgba(234, 88, 12, 0.15); border-color: #ea580c; }
        .card-css      { background: rgba(37, 99, 235, 0.15); border-color: #2563eb; }
        .card-internal { background: rgba(147, 51, 234, 0.15); border-color: #9333ea; }
        .card-external { background: rgba(13, 148, 136, 0.15); border-color: #0d9488; }
        .card-inline   { background: rgba(219, 39, 119, 0.15); border-color: #db2777; }

        .nav-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }
        .card-html:hover     { background: #ea580c; }
        .card-css:hover      { background: #2563eb; }
        .card-internal:hover { background: #9333ea; }
        .card-external:hover { background: #0d9488; }
        .card-inline:hover   { background: #db2777; }

        /* Section Layouts */
        section {
            width: 85%;
            max-width: 650px;
            padding: 40px;
            margin-bottom: 120px; /* Creates aesthetic spacing without using <br> */
            background: #1e293b;
            border-radius: 16px;
            border: 1px solid #334155;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
            text-align: center;
        }
        section h2 {
            margin-top: 0;
            font-size: 1.8rem;
            letter-spacing: 1px;
            border-bottom: 2px solid #334155;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        #HTML h2     { color: #ff7a3c; }
        #CSS h2      { color: #548cff; }
        #INTERNAL h2 { color: #b967ff; }
        #EXTERNAL h2 { color: #2dd4bf; }
        #INLINE h2   { color: #f472b6; }

        .tag-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }
        .tag-item {
            background: #0f172a;
            padding: 15px;
            border-radius: 8px;
            color: #cbd5e1;
            font-size: 1rem;
            border: 1px solid #1e293b;
        }

        /* Back to top Button */
        .top-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(to right, #38bdf8, #818cf8);
            padding: 12px 20px;
            border-radius: 30px;
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.4);
            transition: transform 0.2s;
        }
        .top-btn a {
            color: #0f172a;
            text-decoration: none;
            font-weight: bold;
            font-size: 0.9rem;
            letter-spacing: 1px;
        }
        .top-btn:hover {
            transform: scale(1.05);
        }
    </style>
</head>
<body id="TOP">

    <header>
        <h1>My Responsive Website</h1>
        <div class="subtitle">Courses</div>
    </header>

    <nav class="container">
        <div class="nav-card card-html"><a href="#HTML">HTML</a></div>
        <div class="nav-card card-css"><a href="#CSS">CSS</a></div>
        <div class="nav-card card-internal"><a href="#INTERNAL">INTERNAL</a></div>
        <div class="nav-card card-external"><a href="#EXTERNAL">EXTERNAL</a></div>
        <div class="nav-card card-inline"><a href="#INLINE">INLINE</a></div>
    </nav>

    <section id="HTML">
        <h2>HTML</h2>
        <div class="tag-grid">
            <div class="tag-item">Structure</div>
            <div class="tag-item">Elements</div>
            <div class="tag-item">Tags</div>
            <div class="tag-item">Semantics</div>
        </div>
    </section>

    <section id="CSS">
        <h2>CSS</h2>
        <div class="tag-grid">
            <div class="tag-item">Styling</div>
            <div class="tag-item">Selectors</div>
            <div class="tag-item">Layout</div>
            <div class="tag-item">Colors</div>
        </div>
    </section>

    <section id="INTERNAL">
        <h2>INTERNAL</h2>
        <div class="tag-grid">
            <div class="tag-item">Head</div>
            <div class="tag-item">Document</div>
            <div class="tag-item">Scoped</div>
            <div class="tag-item">Embedded</div>
        </div>
    </section>

    <section id="EXTERNAL">
        <h2>EXTERNAL</h2>
        <div class="tag-grid">
            <div class="tag-item">Reusable</div>
            <div class="tag-item">Global</div>
            <div class="tag-item">Stylesheet</div>
            <div class="tag-item">External File</div>
        </div>
    </section>

    <section id="INLINE">
        <h2>INLINE</h2>
        <div class="tag-grid">
            <div class="tag-item">Attribute</div>
            <div class="tag-item">Specific</div>
            <div class="tag-item">Direct</div>
            <div class="tag-item">Override</div>
        </div>
    </section>

    <div class="top-btn">
        <a href="#TOP">↑ TOP</a>
    </div>

</body>
</html>
